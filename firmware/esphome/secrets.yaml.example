# Copy this file to `secrets.yaml` in the same directory and fill in
# real values. `secrets.yaml` is gitignored and must never be committed.
#
# Generate a fresh api_key with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Do NOT reuse the api_key from another ESPHome device — Home Assistant
# uses it to identify the device.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback AP that the device brings up if it can't reach the main
# Wi-Fi. Must be ≥8 characters (ESPHome enforces).
fallback_ap_password: "CHANGEME_AT_LEAST_8_CHARS"

# Base64-encoded 32-byte key. See the one-liner above.
api_key: "BASE64_ENCODED_32_BYTES_GOES_HERE="

# Password for OTA firmware uploads. Different from the api_key.
ota_password: "CHANGEME_OTA_PASSWORD"
